# Kalshi/Polymarket NBA price snapshots as a systemd *user* service (no root).
# Install alongside the pipeline: see docs/DEPLOYMENT.md#tracking-exchange-prices.
#
# Same runner checkout and --no-sync rule as possession-lab-pipeline.service.
# Each run appends one price row per exchange per upcoming game to the cache.
[Unit]
Description=POSSESSION LAB exchange price snapshot

[Service]
Type=oneshot
WorkingDirectory=%h/possession-lab-runner
# EDIT: the API's data directory (the snapshot log lives in its cache).
Environment=NBA_INSIGHTS_DATA_DIR=%h/Sports-Analytics/data
ExecStart=%h/.local/bin/uv run --frozen --no-sync python -m nba_insights.markets snapshot
NoNewPrivileges=yes
Nice=10
